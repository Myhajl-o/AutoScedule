<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Widget.AutoSchedule.Label"
        android:text="@string/label_faculty" />

    <EditText
        android:id="@+id/input_faculty"
        style="@style/Widget.AutoSchedule.Input"
        android:inputType="text" />

    <TextView
        style="@style/Widget.AutoSchedule.Label"
        android:text="@string/label_course" />

    <EditText
        android:id="@+id/input_course"
        style="@style/Widget.AutoSchedule.Input"
        android:inputType="number"
        android:maxLength="1" />

    <TextView
        style="@style/Widget.AutoSchedule.Label"
        android:text="@string/label_group" />

    <EditText
        android:id="@+id/input_group"
        style="@style/Widget.AutoSchedule.Input"
        android:inputType="text" />

</LinearLayout>
