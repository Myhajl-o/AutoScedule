<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <com.auto.schedule.ui.TerminalButton
            android:id="@+id/btn_show_schedule"
            style="@style/Widget.AutoSchedule.Button"
            android:text="@string/btn_show_schedule" />

        <com.auto.schedule.ui.TerminalButton
            android:id="@+id/btn_input_user_data"
            style="@style/Widget.AutoSchedule.Button"
            android:text="@string/btn_input_user_data" />

        <com.auto.schedule.ui.TerminalButton
            android:id="@+id/btn_input_url"
            style="@style/Widget.AutoSchedule.Button"
            android:text="@string/btn_input_url" />

        <com.auto.schedule.ui.TerminalButton
            android:id="@+id/btn_update_schedule"
            style="@style/Widget.AutoSchedule.Button"
            android:text="@string/btn_update_schedule" />

        <com.auto.schedule.ui.TerminalButton
            android:id="@+id/btn_exit"
            style="@style/Widget.AutoSchedule.Button"
            android:text="@string/btn_exit" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
