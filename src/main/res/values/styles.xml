<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Темна тема у термінальному стилі: чорний фон, моноширинний шрифт. -->
  <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/screen_bg</item>
    <item name="android:statusBarColor">@color/screen_bg</item>
    <item name="android:navigationBarColor">@color/screen_bg</item>
    <item name="android:colorAccent">@color/text_primary</item>
    <item name="android:fontFamily">monospace</item>
    <item name="android:textColorPrimary">@color/text_primary</item>
    <item name="android:textColorSecondary">@color/text_dim</item>
  </style>

  <!-- Діалоги: чорне вікно з білою рамкою. -->
  <style name="AutoSchedule.DialogTheme" parent="android:Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/bg_dialog</item>
    <item name="android:colorAccent">@color/text_primary</item>
    <item name="android:fontFamily">monospace</item>
    <item name="android:textColorPrimary">@color/text_primary</item>
    <item name="android:textColorSecondary">@color/text_dim</item>
  </style>

  <!-- Кнопка: білий прямокутник із чорною рамкою 3dp, без заокруглень. -->
  <style name="Widget.AutoSchedule.Button" parent="android:Widget.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">10dp</item>
    <item name="android:background">@drawable/bg_button</item>
    <item name="android:padding">14dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:stateListAnimator">@null</item>
  </style>

  <!-- Поле введення: чорний фон, білий текст, біла рамка 2dp. -->
  <style name="Widget.AutoSchedule.Input" parent="android:Widget.EditText">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">10dp</item>
    <item name="android:background">@drawable/bg_input</item>
    <item name="android:padding">10dp</item>
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textColorHint">@color/text_dim</item>
    <item name="android:textSize">16sp</item>
  </style>

</resources>
